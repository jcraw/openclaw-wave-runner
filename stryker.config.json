{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test dist/test/mutation-core.test.js dist/test/quality-matrix.test.js dist/test/phase1-core.test.js dist/test/phase1-fault.test.js dist/test/safety-backup.test.js"
  },
  "mutator": {
    "excludedMutations": ["StringLiteral"]
  },
  "mutate": [
    "dist/src/core/budget.js",
    "dist/src/core/lease.js",
    "dist/src/domain/safety.js"
  ],
  "incremental": true,
  "incrementalFile": "tmp/stryker-incremental.json",
  "timeoutMS": 60000,
  "concurrency": 2,
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "tmp/mutation-report.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 80
  },
  "disableTypeChecks": true,
  "ignoreStatic": true,
  "tempDirName": "tmp/stryker",
  "cleanTempDir": true
}
