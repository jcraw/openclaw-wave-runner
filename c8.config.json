{
  "all": true,
  "include": ["dist/src/**/*.js"],
  "exclude": [
    "dist/src/index.js",
    "dist/src/contracts.js",
    "dist/src/adapters/ports.js",
    "dist/scripts/**",
    "dist/test/**",
    "**/*.d.ts"
  ],
  "reporter": ["text-summary", "text", "lcov"],
  "reports-dir": "coverage",
  "check-coverage": true,
  "statements": 80,
  "branches": 60,
  "functions": 75,
  "lines": 80
}
